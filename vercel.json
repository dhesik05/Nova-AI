{
  "version": 2,
  "name": "nova-ai",
  "builds": [
    {
      "src": "AI-Chatbot/api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "100mb",
        "runtime": "python3.10"
      }
    },
    {
      "src": "AI-Chatbot/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "AI-Chatbot/api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "AI-Chatbot/frontend/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "AI-Chatbot/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "AI-Chatbot/frontend/js/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "AI-Chatbot/frontend/icons/$1"
    },
    {
      "src": "/share/(.*)",
      "dest": "AI-Chatbot/frontend/share.html"
    },
    {
      "src": "/(.*)",
      "dest": "AI-Chatbot/frontend/index.html"
    }
  ],
  "env": {
    "PYTHONPATH": "$PYTHONPATH:/var/task/AI-Chatbot/backend:/var/task/backend"
  }
}
